# Postgres connection string (Neon, Supabase, or your own server)
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
# Set to false only for a Postgres without TLS (e.g. docker on your home server)
DATABASE_SSL=true

# Login for the whole app (browser basic-auth prompt)
APP_USER=admin
APP_PASSWORD=change-me-to-something-long

# SMTP used to send invoices
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=app-password
MAIL_FROM="Your Name <you@example.com>"
# Optional: blind copy every invoice to yourself
MAIL_BCC=you@example.com
